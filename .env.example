# 运行环境：development / production。当前主要用于日志和后续行为分支。
APP_ENV=development

# PostgreSQL 连接串，必填。
# 示例格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://weibo:password@127.0.0.1:5432/weibo_group_chat

# 后端 API 端口。按当前方案固定使用 6001。
BACKEND_PORT=6001

# 后端监听地址。0.0.0.0 可供 Tailscale 内网访问；也可填写本机的 100.x Tailscale IP 进一步收窄监听范围。
BACKEND_BIND_ADDRESS=0.0.0.0

# 前端开发端口；生产环境前端由后端 6001 端口统一提供。
FRONTEND_PORT=6001

# 前端静态服务监听地址，规则同 BACKEND_BIND_ADDRESS。
FRONTEND_BIND_ADDRESS=0.0.0.0

# frontend 命令托管的 Vite 构建产物目录。
FRONTEND_DIST_DIR=frontend/dist

# 可选：额外允许访问 API 的前端 Origin，多个值使用逗号分隔且必须写完整 scheme、主机和端口。
# 允许访问实时接口的页面来源；多个完整 Origin 使用逗号分隔。
CORS_ALLOWED_ORIGINS=https://homeserver.tailed5977.ts.net

# 微博网页版群聊地址。无特殊情况不用改。
WEIBO_CHAT_URL=https://api.weibo.com/chat#/chat

# Chromium 持久化用户目录，用于复用微博登录态。
# monitor 首次启动或检测到登录失效时会发送 DOM 中的二维码原图；扫码后继续使用这里的 cookies/localStorage。
WEIBO_PROFILE_DIR=.weibo-profile

# 是否以无头模式运行浏览器。服务器长期运行及二维码截图登录均建议保持 true。
HEADLESS=true

# 可选：Chrome / Chromium 可执行文件路径。
# 留空时程序会自动查找 google-chrome-stable、google-chrome、chromium-browser、chromium 等常见命令。
# Linux 示例：CHROME_EXECUTABLE=/usr/bin/google-chrome
# macOS 示例：CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE=

# 可选：Linux 容器或受限环境中可能需要开启；普通服务器优先保持 false。
CHROME_NO_SANDBOX=false

# Chrome DevTools 本机调试端口，monitor 用它探测页面 URL/title。
# 如果服务器上 9222 已被占用，可以换成其他本机端口。
CHROME_DEBUG_PORT=9222

# 可选：只监控指定群聊。优先使用 TARGET_GROUP_ID；没有稳定 ID 时可先用群名。
TARGET_GROUP_NAME=
TARGET_GROUP_ID=

# 可选：需要触发企业微信通知的目标发送人。优先使用 TARGET_SENDER_ID；没有稳定 ID 时可先用昵称。
TARGET_SENDER_NAME=
TARGET_SENDER_ID=

# 企业微信消息中转服务地址。当前服务部署在 Tailscale 内网，建议优先使用 MagicDNS。
WEWORK_RELAY_URL=http://aliserver.tailed5977.ts.net:5001

# 企业微信消息中转服务鉴权密钥。自动发送登录二维码及消息通知时必填，不要提交真实密钥。
WEWORK_RELAY_API_KEY=

# 可选：接收登录二维码及消息通知的企业微信成员 userid；为空时由中转服务使用默认接收人。
WEWORK_RELAY_TOUSER=

# 通知 outbox 轮询间隔，单位毫秒。
NOTIFICATION_POLL_INTERVAL_MS=3000

# 单条通知最大尝试次数，包括首次发送。失败后按指数退避自动重试。
NOTIFICATION_MAX_ATTEMPTS=8

# 服务健康心跳间隔，单位秒。
HEALTH_CHECK_INTERVAL_SECONDS=60

# 超过该秒数未收到 monitor 心跳时，健康与指标接口标记 monitor 为 stale。
MONITOR_STALE_AFTER_SECONDS=180

# 页面定时重载间隔，单位分钟。定期释放微博网页长期运行累积的 renderer 资源；0 表示关闭。
PAGE_RELOAD_INTERVAL_MINUTES=360

# 未登录时重新检查二维码的间隔，单位秒。二维码内容变化后会重新发送图片，相同二维码不会重复发送。
LOGIN_QR_REFRESH_SECONDS=120

# 图片 FID → URL 内存缓存 TTL 和最大条数，用于限制长期运行内存占用。
IMAGE_CACHE_TTL_SECONDS=86400
IMAGE_CACHE_MAX_ITEMS=1000

# 日志级别：debug / info / warn / error。
LOG_LEVEL=info
