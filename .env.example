# 运行环境：development / production。当前主要用于日志和后续行为分支。
APP_ENV=development

# PostgreSQL 连接串，必填。
# 示例格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://weibo:password@127.0.0.1:5432/weibo_group_chat

# 后端 API 端口。按当前方案固定使用 6001。
BACKEND_PORT=6001

# 前端 Vue 开发/部署端口。按当前方案固定使用 6002。
FRONTEND_PORT=6002

# 微博网页版群聊地址。无特殊情况不用改。
WEIBO_CHAT_URL=https://api.weibo.com/chat#/chat

# Playwright / Chromium 持久化用户目录，用于复用微博登录态。
# 首次登录成功后，后续无头运行会继续使用这里的 cookies/localStorage。
WEIBO_PROFILE_DIR=.weibo-profile

# 是否以无头模式运行浏览器。服务器长期运行建议 true；首次手动登录可临时改为 false。
HEADLESS=true

# 可选：Chrome / Chromium 可执行文件路径。
# 留空时程序会自动查找 google-chrome-stable、google-chrome、chromium-browser、chromium 等常见命令。
# Linux 示例：CHROME_EXECUTABLE=/usr/bin/google-chrome
# macOS 示例：CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE=

# 可选：Linux 容器或受限环境中可能需要开启；普通服务器优先保持 false。
CHROME_NO_SANDBOX=false

# Chrome DevTools 本机调试端口，monitor 用它探测页面 URL/title。
# 如果服务器上 9222 已被占用，可以换成其他本机端口。
CHROME_DEBUG_PORT=9222

# 可选：只监控指定群聊。优先使用 TARGET_GROUP_ID；没有稳定 ID 时可先用群名。
TARGET_GROUP_NAME=
TARGET_GROUP_ID=

# 可选：需要触发企业微信通知的目标发送人。优先使用 TARGET_SENDER_ID；没有稳定 ID 时可先用昵称。
TARGET_SENDER_NAME=
TARGET_SENDER_ID=

# 企业微信消息中转服务地址。当前服务部署在 Tailscale 内网，建议优先使用 MagicDNS。
WEWORK_RELAY_URL=http://aliserver.tailed5977.ts.net:5001

# 企业微信消息中转服务鉴权密钥，必填。不要提交真实密钥。
WEWORK_RELAY_API_KEY=

# 可选：企业微信成员 userid；为空时由中转服务按 @all 发送。
WEWORK_RELAY_TOUSER=

# 监控轮询间隔，单位毫秒。用于页面状态检查和兜底扫描。
MONITOR_POLL_INTERVAL_MS=1000

# 服务健康心跳间隔，单位毫秒。
HEALTH_CHECK_INTERVAL_MS=30000

# 页面定时重载间隔，单位分钟。0 表示不主动定时重载。
PAGE_RELOAD_INTERVAL_MINUTES=0

# 采集端内存去重 TTL，单位秒。数据库仍会通过 dedupe_key 做最终去重。
DEDUPE_TTL_SECONDS=86400

# 采集端内存去重最大条数。
DEDUPE_MAX_ITEMS=1000

# 日志级别：debug / info / warn / error。
LOG_LEVEL=info
