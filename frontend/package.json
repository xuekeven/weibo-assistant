{
  "name": "weibo-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 6002",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test src/utils/requestGate.test.ts",
    "build": "pnpm run typecheck && vite build",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "preview": "vite preview --host 0.0.0.0 --port 6002"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "ant-design-vue": "4.2.6",
    "dayjs": "1.11.21",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  }
}
