[Unit]
Description=weibo-assistant Weibo web chat monitor
Wants=network-online.target
After=network-online.target weibo-assistant-server.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=APP_ENV=production
Environment=HOME=__RUN_HOME__
EnvironmentFile=-__APP_DIR__/.env
# RAPL 能耗计数器默认仅 root 可读；只把 package 能耗读取权限授予 monitor 所在组。
ExecStartPre=+/bin/chgrp __RUN_GROUP__ /sys/class/powercap/intel-rapl:0/energy_uj
ExecStartPre=+/bin/chmod 0640 /sys/class/powercap/intel-rapl:0/energy_uj
ExecStart=__APP_DIR__/bin/weibo-assistant monitor
Restart=always
RestartSec=8
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
StandardOutput=append:__APP_DIR__/logs/monitor.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
